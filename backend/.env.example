# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local development:
MONGODB_URI=mongodb://localhost:27017/tiet-medicare

# For MongoDB Atlas (production) - Get this from MongoDB Atlas dashboard:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tiet-medicare?retryWrites=true&w=majority

# JWT Configuration
# IMPORTANT: Generate a strong secret for production (at least 32 characters)
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure_at_least_32_characters
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# CORS Configuration
# For local development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# For production (replace with your actual frontend URLs):
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app.netlify.app

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=TIET Medicare <noreply@tietmedicare.com>

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
